# Linux dev container for Port Anything: the Linux-only parts (bubblewrap sandbox,
# strace, GNU vs uutils vs busybox vs toybox, jq vs jaq vs gojq, the C and Rust
# example programs) are developed and tested here, also from macOS. Use it through
# scripts/dev-linux.sh, which mounts the repo and passes the security options
# bubblewrap needs.
#
# Ubuntu 25.10 ships both coreutils: uutils is the default (/usr/bin/sort) and
# GNU is installed with a "gnu" prefix (/usr/bin/gnusort).
FROM ubuntu:25.10

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      bubblewrap strace busybox toybox jq gojq \
      gcc libc6-dev cargo \
      ca-certificates curl xz-utils git util-linux \
 && rm -rf /var/lib/apt/lists/* \
 && gnusort --version | head -n 1 \
 && sort --version | head -n 1

ARG NODE_VERSION=22.23.3
ARG NODE_SHA256_ARM64=a44aeb94849a299b22df10b9e622ec2f605c2183501bc40590705131de7c740f
ARG NODE_SHA256_X64=df450af89261115ef9f9e3830c3eeb2cc9213b63c720b1af623cb5dcbe2e02de
RUN case "$(uname -m)" in \
      aarch64) arch=arm64 sha=$NODE_SHA256_ARM64 ;; \
      x86_64) arch=x64 sha=$NODE_SHA256_X64 ;; \
      *) echo "unsupported architecture $(uname -m)" >&2; exit 1 ;; \
    esac \
 && curl -fsSLo /tmp/node.tar.xz "https://nodejs.org/dist/v$NODE_VERSION/node-v$NODE_VERSION-linux-$arch.tar.xz" \
 && echo "$sha  /tmp/node.tar.xz" | sha256sum -c - \
 && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 --exclude='*/CHANGELOG.md' --exclude='*/README.md' \
 && rm /tmp/node.tar.xz \
 && node --version

# Same pnpm as the packageManager field in package.json.
ARG PNPM_VERSION=10.10.0
RUN npm install -g --no-fund --no-audit "pnpm@$PNPM_VERSION" && pnpm --version

# jaq has no Ubuntu package; use the upstream release binary.
ARG JAQ_VERSION=3.1.1
ARG JAQ_SHA256_AARCH64=bdda42d5a8c060a2c7916b287a227e7750d5fccbd4c37aacf0ab863010921829
ARG JAQ_SHA256_X86_64=5922c7b67d9bd6841d6676d1f954410c6bf04b47203dcb661c4f052dfef7f454
RUN arch=$(uname -m) \
 && case "$arch" in aarch64) sha=$JAQ_SHA256_AARCH64 ;; x86_64) sha=$JAQ_SHA256_X86_64 ;; *) exit 1 ;; esac \
 && curl -fsSLo /usr/local/bin/jaq "https://github.com/01mf02/jaq/releases/download/v$JAQ_VERSION/jaq-$arch-unknown-linux-gnu" \
 && echo "$sha  /usr/local/bin/jaq" | sha256sum -c - \
 && chmod 755 /usr/local/bin/jaq \
 && jaq --version

ENV PNPM_HOME=/pnpm \
    npm_config_store_dir=/pnpm/store \
    CI=true
WORKDIR /repo
