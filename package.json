{
  "name": "port-anything-monorepo",
  "private": true,
  "type": "module",
  "description": "Workspace root for Port Anything. The published CLI lives in packages/cli.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karolkulesza/port-anything.git"
  },
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint:workflows": "docker run --rm -v \"$PWD:/repo\" -w /repo rhysd/actionlint:1.7.12 -color",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "~3.0.3",
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "5.0.3"
  }
}
