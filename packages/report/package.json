{
  "name": "@port-anything/report",
  "version": "0.0.0",
  "description": "Port Anything static HTML report and badge.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karolkulesza/port-anything.git",
    "directory": "packages/report"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "report.schema.json"],
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@port-anything/core": "workspace:*",
    "zod": "4.6.5"
  }
}
